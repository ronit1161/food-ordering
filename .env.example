# =============================================================================
# Food Ordering Application - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MongoDB Atlas / Local)
# -----------------------------------------------------------------------------
NEXT_MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/food-ordering?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# NextAuth Authentication & Session Configuration
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your_nextauth_generated_random_secret_string
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console)
# -----------------------------------------------------------------------------
NEXT_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# -----------------------------------------------------------------------------
# Cloudinary Media Storage (For Image Uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# Miscellaneous Secrets (Optional / Custom Tokens)
# -----------------------------------------------------------------------------
NEXT_JWT_SECRET=your_custom_jwt_secret
NEXT_SECRET_STRING=your_custom_secret_string
